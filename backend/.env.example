# Copia este archivo como .env y ajusta los valores. NUNCA subas .env al repositorio.

# --- General ---
# desarrollo | produccion | pruebas
ENTORNO=desarrollo
DEBUG=true
# Origen permitido por CORS y base de los enlaces (QR, recuperación de contraseña, retorno de pagos).
FRONTEND_URL=http://localhost:4200
ALLOWED_HOSTS=localhost,127.0.0.1,backend
# Proxies de confianza delante de la API: 0 en local, 1 detrás de Nginx.
NUM_PROXIES=0

# Secretos: genera cada uno con
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
DJANGO_SECRET_KEY=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_SECRET=cambia-esto-por-otro-secreto-largo-y-aleatorio
# Duración de la sesión en horas.
JWT_HORAS=2

# --- Base de datos ---
# Vacío = SQLite local (backend/db.sqlite3). Para PostgreSQL:
#   DATABASE_URL=postgres://brasa:clave@localhost:5432/brasa
DATABASE_URL=

# --- Reglas de negocio ---
# El valor original de la app era 19 (IVA). Los restaurantes en Colombia suelen liquidar impuesto
# al consumo (INC) del 8 %: confírmalo con el contador del negocio.
IMPUESTO_PORCENTAJE=19
PROPINA_MAX_PORCENTAJE=20

# --- Pagos ---
# simulado = pasarela de pruebas (no mueve dinero). wompi = Wompi (usa llaves de sandbox: pub_test_ / prv_test_).
PAGOS_PROVEEDOR=simulado
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_EVENTS_SECRET=
WOMPI_INTEGRITY_SECRET=
WOMPI_API_URL=https://sandbox.wompi.co/v1
WOMPI_CHECKOUT_URL=https://checkout.wompi.co/p/

# --- Usuarios iniciales (los crea "python manage.py sembrar" si no existen) ---
SEMILLA_ADMIN_EMAIL=admin@brasa.local
# Al menos 10 caracteres. Si se deja vacío se genera una y se muestra una sola vez.
SEMILLA_ADMIN_PASSWORD=
# Contraseña de cocina@brasa.local y mesero@brasa.local (solo fuera de producción).
SEMILLA_DEMO_PASSWORD=

# --- Keycloak (opcional; vacío = desactivado) ---
# Dirección pública de Keycloak (la del navegador y el emisor de los tokens).
KEYCLOAK_URL=
# Dirección que usa el backend para descargar las llaves (si es distinta; en Docker: http://keycloak:8080).
KEYCLOAK_URL_INTERNA=
KEYCLOAK_REALM=brasa
KEYCLOAK_CLIENTE=brasa-web
