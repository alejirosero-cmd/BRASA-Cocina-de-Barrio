# Variables para docker compose. Copia este archivo como .env (en esta misma carpeta) y cambia los valores.
# Genera cada secreto con:  python -c "import secrets; print(secrets.token_urlsafe(48))"

POSTGRES_PASSWORD=cambia-esta-clave-de-base-de-datos
DJANGO_SECRET_KEY=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_SECRET=cambia-esto-por-otro-secreto-largo-y-aleatorio

# Contraseñas de las cuentas iniciales (mínimo 10 caracteres).
SEMILLA_ADMIN_PASSWORD=
SEMILLA_DEMO_PASSWORD=

IMPUESTO_PORCENTAJE=19

# Puerto de la web en tu computador (http://localhost:8088)
PUERTO_WEB=8088

# --- Keycloak (inicio de sesión único del personal) ---
PUERTO_KEYCLOAK=8089
# Usuario "admin" de la consola de Keycloak (http://localhost:8089/admin).
KEYCLOAK_ADMIN_PASSWORD=cambia-esta-clave-de-keycloak
# Contraseñas de las cuentas del realm "brasa": admin, y cocina/mesero (mínimo 10 caracteres).
KC_CLAVE_ADMIN=
KC_CLAVE_PERSONAL=
