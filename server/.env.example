# Copia este archivo como .env y ajusta los valores. NUNCA subas .env al repositorio.

# --- General ---
NODE_ENV=development
PORT=3000
# Origen permitido por CORS (la URL del frontend Angular).
FRONTEND_URL=http://localhost:4200

# --- Base de datos (SQLite) ---
DATABASE_URL="file:./dev.db"

# --- Autenticación ---
# Secreto para firmar los JWT. Genera uno largo y aleatorio, por ejemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
# Duración del token de acceso (formato de la librería ms: 2h, 30m, ...).
JWT_EXPIRES_IN=2h

# --- Reglas de negocio ---
# Porcentaje de impuesto aplicado sobre (subtotal - descuento).
# El valor original de la app era 19 (IVA). Los restaurantes en Colombia suelen liquidar
# impuesto al consumo (INC) del 8 %: confírmalo con el contador del negocio.
IMPUESTO_PORCENTAJE=19
# Propina máxima permitida (porcentaje). La propina en Colombia es voluntaria.
PROPINA_MAX_PORCENTAJE=20

# --- Pagos ---
# simulado = proveedor local de pruebas (no mueve dinero). wompi = Wompi (usa llaves de sandbox).
PAGOS_PROVEEDOR=simulado
# Llaves de Wompi: https://comercios.wompi.co → Desarrolladores. Usa SIEMPRE las de pruebas (pub_test_ / prv_test_).
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_EVENTS_SECRET=
WOMPI_INTEGRITY_SECRET=
# https://sandbox.wompi.co/v1 (pruebas) o https://production.wompi.co/v1 (producción)
WOMPI_API_URL=https://sandbox.wompi.co/v1
WOMPI_CHECKOUT_URL=https://checkout.wompi.co/p/

# --- Usuario administrador inicial (lo crea el seed si no existe) ---
SEED_ADMIN_EMAIL=admin@brasa.local
# Debe tener al menos 10 caracteres. Si se deja vacío, el seed genera una y la muestra una sola vez.
SEED_ADMIN_PASSWORD=
# Contraseña de los usuarios de prueba cocina@brasa.local y mesero@brasa.local (solo fuera de producción).
SEED_DEMO_PASSWORD=
